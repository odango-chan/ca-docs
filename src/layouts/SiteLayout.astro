---
import '../styles/global.css';
interface Props { title: string; description?: string; lang?: 'zh' | 'en'; }
const {
  title,
  lang = 'zh',
  description = lang === 'zh' ? 'ConnectionAgent 能力、API 与组件边界文档。' : 'ConnectionAgent capabilities, APIs and component boundaries.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
const basePath = base.endsWith('/') ? base.slice(0, -1) : base;
const currentPath = Astro.url.pathname.startsWith(basePath) ? (Astro.url.pathname.slice(basePath.length) || '/') : Astro.url.pathname;
const zhPath = currentPath.startsWith('/en') ? (currentPath.slice(3) || '/') : currentPath;
const enPath = currentPath.startsWith('/en') ? currentPath : `/en${currentPath === '/' ? '/' : currentPath}`;
const labels = lang === 'zh'
  ? { architecture: '架构', footer: '机器契约仍以各组件所属仓库为权威来源。', nav: '主导航', language: '语言' }
  : { architecture: 'Architecture', footer: 'Owner repositories remain the contract authority.', nav: 'Main navigation', language: 'Language' };
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(href(zhPath), Astro.url.origin)} />
    <link rel="alternate" hreflang="en" href={new URL(href(enPath), Astro.url.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(href(zhPath), Astro.url.origin)} />
    <title>{title} · CA Docs</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-row">
        <a class="brand" href={lang === 'zh' ? href('/') : href('/en/')}><span class="brand-mark">CA</span><span>Docs</span></a>
        <nav aria-label={labels.nav}>
          <a class="nav-api" href={lang === 'zh' ? href('/api/') : href('/en/api/')}>API</a>
          <a href={lang === 'zh' ? href('/components/ca-5gc-sim/') : href('/en/components/ca-5gc-sim/')}>ca-5gc-sim</a>
          <a href={lang === 'zh' ? href('/components/ca-provider-common/') : href('/en/components/ca-provider-common/')}>provider-common</a>
          <a href={lang === 'zh' ? href('/architecture/') : href('/en/architecture/')}>{labels.architecture}</a>
          <span class="language-switch" aria-label={labels.language}>
            <a class:list={[{ active: lang === 'zh' }]} href={href(zhPath)}>中文</a><span>/</span><a class:list={[{ active: lang === 'en' }]} href={href(enPath)}>English</a>
          </span>
          <a href="https://github.com/odango-chan/ca-docs">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <main class="shell"><slot /></main>
    <footer class="site-footer"><div class="shell footer-row"><span>CA Docs</span><span>{labels.footer}</span></div></footer>
  </body>
</html>
