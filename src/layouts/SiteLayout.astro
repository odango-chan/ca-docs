---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'ConnectionAgent capabilities, APIs and component boundaries.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base}${value.replace(/^\//, '')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · CA Docs</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-row">
        <a class="brand" href={href('/')}>
          <span class="brand-mark">CA</span>
          <span>Docs</span>
        </a>
        <nav aria-label="Main navigation">
          <a href={href('/components/ca-5gc-sim/')}>ca-5gc-sim</a>
          <a href={href('/architecture/')}>Architecture</a>
          <a href="https://github.com/odango-chan/ca-docs">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-row">
        <span>CA Docs</span>
        <span>Owner repositories remain the contract authority.</span>
      </div>
    </footer>
  </body>
</html>
