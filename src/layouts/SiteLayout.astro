---
import '../styles/global.css';
interface Props { title: string; description?: string; lang?: 'zh' | 'en'; }
const {
  title,
  lang = 'zh',
  description = lang === 'zh'
    ? 'ConnectionAgent 的系统架构、可靠性评估与组件公开文档。'
    : 'ConnectionAgent system architecture, reliability evaluation, and public component documentation.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
const basePath = base.endsWith('/') ? base.slice(0, -1) : base;
const currentPath = Astro.url.pathname.startsWith(basePath) ? (Astro.url.pathname.slice(basePath.length) || '/') : Astro.url.pathname;
const isEnglish = lang === 'en';
const zhPath = currentPath.startsWith('/en') ? (currentPath.slice(3) || '/') : currentPath;
const enPath = currentPath.startsWith('/en') ? currentPath : `/en${currentPath === '/' ? '/' : currentPath}`;
const isHome = currentPath === '/' || currentPath === '/en' || currentPath === '/en/';
const pathFor = (zh: string) => lang === 'zh' ? href(zh) : href(`/en${zh === '/' ? '/' : zh}`);
const labels = lang === 'zh'
  ? {
      nav: '主导航', language: '语言', home: '文档首页', architecture: '系统架构',
      governance: '文档来源与治理', benchmark: 'Benchmark 架构', api: 'API 总览',
      components: '组件参考', simulator: '5GC 模拟器', simulatorApi: 'HTTP API',
      facts: 'Facts', operations: 'Operations', standalone: '独立运行',
      common: '公共工具契约', commonApi: 'HTTP API', subject: 'Subject Identity',
      boundaries: '职责边界', source: '文档与契约来源',
      footer: 'CA Docs 负责跨仓解释与导航；机器契约、实现行为和权威事实以各所属仓库为准。',
      systemGroup: '系统设计', benchmarkGroup: '评估方法', componentGroup: '组件参考',
      simulatorGroup: '5GC 模拟器', commonGroup: '公共工具', github: '查看源码',
    }
  : {
      nav: 'Main navigation', language: 'Language', home: 'Documentation home',
      architecture: 'System architecture', governance: 'Sources & governance',
      benchmark: 'Benchmark architecture', api: 'API overview', components: 'Components',
      simulator: '5GC simulator', simulatorApi: 'HTTP API', facts: 'Facts',
      operations: 'Operations', standalone: 'Standalone',
      common: 'Shared tool contracts', commonApi: 'HTTP API', subject: 'Subject Identity',
      boundaries: 'Responsibility boundaries', source: 'Docs & contract ownership',
      footer: 'CA Docs owns cross-repository explanations and navigation; machine contracts, implementation behavior, and authoritative facts remain in their owner repositories.',
      systemGroup: 'System design', benchmarkGroup: 'Evaluation', componentGroup: 'Component reference',
      simulatorGroup: '5GC simulator', commonGroup: 'Shared tools', github: 'View source',
    };
const normalizedPath = currentPath.startsWith('/en/') ? (currentPath.slice(3) || '/') : currentPath === '/en' ? '/' : currentPath;
const isActive = (path: string) => normalizedPath.replace(/\/$/, '') === path.replace(/\/$/, '');
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8f8f6" />
    <link rel="alternate" hreflang="zh-CN" href={new URL(href(zhPath), Astro.url.origin)} />
    <link rel="alternate" hreflang="en" href={new URL(href(enPath), Astro.url.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(href(zhPath), Astro.url.origin)} />
    <title>{title} · CA Docs</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={lang === 'zh' ? href('/') : href('/en/')} aria-label="CA Docs home">
          <span class="brand-mark">CA</span><span class="brand-name">ConnectionAgent <span>Docs</span></span>
        </a>
        <nav class="top-nav" aria-label={labels.nav}>
          <a class:list={{ 'top-link-active': currentPath.includes('/architecture') }} href={pathFor('/architecture/system/')}>{labels.architecture}</a>
          <a class:list={{ 'top-link-active': currentPath.includes('/benchmark') }} href={pathFor('/benchmark/')}>{labels.benchmark}</a>
          <a class:list={{ 'top-link-active': currentPath.includes('/components') }} href={pathFor('/components/ca-5gc-sim/')}>{labels.components}</a>
          <a class:list={{ 'top-link-active': currentPath.includes('/api') }} href={pathFor('/api/')}>{labels.api}</a>
        </nav>
        <div class="header-tools">
          <span class="language-switch" aria-label={labels.language}>
            <a class:list={{ active: lang === 'zh' }} href={href(zhPath)} lang="zh-CN">中</a><span aria-hidden="true">/</span><a class:list={{ active: lang === 'en' }} href={href(enPath)} lang="en">EN</a>
          </span>
          <a class="source-link" href="https://github.com/odango-chan/ca-docs" aria-label={labels.github}>GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>
    {isHome ? (
      <main id="main-content" class="home-main"><slot /></main>
    ) : (
      <div class="docs-frame">
        <aside class="docs-sidebar" aria-label={labels.components}>
          <a class:list={{ 'sidebar-home': true, active: isHome }} href={lang === 'zh' ? href('/') : href('/en/')}><span aria-hidden="true">⌂</span>{labels.home}</a>
          <div class="sidebar-group">
            <p>{labels.systemGroup}</p>
            <a class:list={{ active: isActive('/architecture/system') }} href={pathFor('/architecture/system/')}>{labels.architecture}</a>
            <a class:list={{ active: isActive('/architecture') }} href={pathFor('/architecture/')}>{labels.governance}</a>
          </div>
          <div class="sidebar-group">
            <p>{labels.benchmarkGroup}</p>
            <a class:list={{ active: isActive('/benchmark') }} href={pathFor('/benchmark/')}>{labels.benchmark}</a>
          </div>
          <div class="sidebar-group">
            <p>{labels.componentGroup}</p>
            <a class:list={{ active: isActive('/api') }} href={pathFor('/api/')}>{labels.api}</a>
          </div>
          <div class="sidebar-group">
            <p>{labels.simulatorGroup}</p>
            <a class:list={{ active: isActive('/components/ca-5gc-sim') && !currentPath.includes('/api') && !currentPath.includes('/facts') && !currentPath.includes('/operations') && !currentPath.includes('/standalone') }} href={pathFor('/components/ca-5gc-sim/')}>{labels.simulator}</a>
            <a class:list={{ active: currentPath.includes('/components/ca-5gc-sim/api') }} href={pathFor('/components/ca-5gc-sim/api/')}>{labels.simulatorApi}</a>
            <a class:list={{ active: currentPath.includes('/components/ca-5gc-sim/facts') }} href={pathFor('/components/ca-5gc-sim/facts/')}>{labels.facts}</a>
            <a class:list={{ active: currentPath.includes('/components/ca-5gc-sim/operations') }} href={pathFor('/components/ca-5gc-sim/operations/')}>{labels.operations}</a>
            <a class:list={{ active: currentPath.includes('/components/ca-5gc-sim/standalone') }} href={pathFor('/components/ca-5gc-sim/standalone/')}>{labels.standalone}</a>
          </div>
          <div class="sidebar-group">
            <p>{labels.commonGroup}</p>
            <a class:list={{ active: isActive('/components/tool-common') }} href={pathFor('/components/tool-common/')}>{labels.common}</a>
            <a class:list={{ active: currentPath.includes('/components/tool-common/api') }} href={pathFor('/components/tool-common/api/')}>{labels.commonApi}</a>
            <a class:list={{ active: currentPath.includes('/components/tool-common/subject-identity') }} href={pathFor('/components/tool-common/subject-identity/')}>{labels.subject}</a>
            <a class:list={{ active: currentPath.includes('/components/tool-common/boundaries') }} href={pathFor('/components/tool-common/boundaries/')}>{labels.boundaries}</a>
          </div>
          <div class="sidebar-note">
            <span class="sidebar-note-label">{labels.source}</span>
            <p>{labels.footer}</p>
            <a href="https://github.com/odango-chan/ca-docs">{labels.github} ↗</a>
          </div>
        </aside>
        <main id="main-content" class="docs-content"><div class="docs-article"><slot /></div></main>
      </div>
    )}
    <footer class="site-footer">
      <div class="footer-inner"><a class="footer-brand" href={lang === 'zh' ? href('/') : href('/en/')}>CA Docs</a><span>{labels.footer}</span><a href="https://github.com/odango-chan/ca-docs">GitHub ↗</a></div>
    </footer>
  </body>
</html>
