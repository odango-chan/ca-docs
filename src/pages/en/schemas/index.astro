---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getJsonSchemaSources, loadPublicCatalog } from '../../../lib/public-catalog';

const base = import.meta.env.BASE_URL;
const href = (value: string) => base.replace(/\/?$/, '/') + value.replace(/^\/+/, '');
const schemas = loadPublicCatalog().flatMap(({ component, snapshot }) =>
  getJsonSchemaSources(snapshot).map((source: any) => ({
    componentId: component.id,
    componentTitle: component.title?.en || component.id,
    repository: component.repository,
    source,
    commit: source.sourceCommit || snapshot.source?.commit,
  })),
);
---
<SiteLayout title="Schema Explorer" lang="en">
  <section class="home-hero">
    <h1>Schema Explorer</h1>
    <p>Browse JSON Schema fields, types, required constraints, enums, conditional rules, and cross-file references by Owner. Original Schema files are downloadable only when the Owner explicitly authorizes raw publication.</p>
  </section>
  <section class="home-section">
    {schemas.length > 0 ? (
      <div class="doc-index">
        {schemas.map((entry) => (
          <a class="doc-row" href={href('/en/schemas/' + entry.componentId + '/' + entry.source.role + '/')}>
            <div>
              <strong>{entry.componentTitle} · {entry.source.metadata?.title || entry.source.role}</strong>
              <span>{entry.source.role} · {entry.source.path} · {entry.source.contractVersion || 'Living docs'}</span>
            </div>
            <span>→</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="notice">
        <strong>The Schema Catalog has not yet been refreshed to CA Docs v2 snapshots.</strong>
        <p>Schema pages are generated automatically after Owner Manifest v1alpha2 migration and a strict sync.</p>
      </div>
    )}
  </section>
</SiteLayout>
