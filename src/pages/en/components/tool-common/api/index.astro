---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import data from '../../../../../../data/generated/tool-common.json';
const base=import.meta.env.BASE_URL; const href=(v:string)=>`${base.replace(/\/?$/, '/')}${v.replace(/^\/+/, '')}`;
const fieldDetail=(f:any)=>{
 if(Object.prototype.hasOwnProperty.call(f,'const')) return `Fixed：${f.const}`;
 if(Array.isArray(f.enum)) return `Values：${f.enum.join(' / ')}`;
 return f.description || `Type：${f.type}`;
};
const surfaces=[['provider',data.api.provider],['control',data.api.control]] as const;
---
<SiteLayout title="tool-common HTTP API" lang="en">
<section class="hero"><span class="eyebrow">tool-common / HTTP API</span><h1>HTTP API</h1>
<p class="lede">Provider is the read-only Runtime/Host surface. Control is the trusted configure/reset surface. They use separate listeners and routes.</p>
<div class="page-tabs"><a class="primary-tab" href={href('/en/components/tool-common/api/')}>HTTP API</a><a href={href('/en/components/tool-common/subject-identity/')}>Subject Identity</a><a href={href('/en/components/tool-common/boundaries/')}>Boundaries</a><a href={href('/en/components/tool-common/')}>Overview</a></div></section>
{surfaces.map(([key,surface])=><section class="section" id={key}><div class="section-head"><div><span class="eyebrow">{key === 'provider' ? 'Provider listener' : 'Control listener'}</span><h2>{surface.title}</h2></div><p>{surface.description}</p></div>
{key === 'control' && <div class="notice"><strong>Trusted control surface, not an Agent tool.</strong></div>}
<div class="api-list">{surface.routes.map((route:any)=>{const req=route.request?.schema?surface.schemas[route.request.schema]:null;return <article class="api-card"><div class="api-heading"><span class:list={['method-badge',route.method.toLowerCase()]}>{route.method}</span><code class="api-path">{route.path}</code></div><h3>{route.summary}</h3><div class="api-meta"><span>operationId</span><code>{route.operationId}</code></div>
{req && <div class="api-block"><strong>Request</strong><table><thead><tr><th>Field</th><th>Required</th><th>Type / values</th></tr></thead><tbody>{req.fields.map((f:any)=><tr><td><code>{f.path}</code></td><td>{f.required ? 'Yes' : 'No'}</td><td>{fieldDetail(f)}</td></tr>)}</tbody></table>{route.request.example && <details class="api-example"><summary>Request example</summary><pre><code>{JSON.stringify(route.request.example,null,2)}</code></pre></details>}</div>}
<div class="api-block"><strong>Responses</strong><div class="response-list">{route.responses.map((r:any)=><div class="response-row"><code class="status-code">{r.status}</code><div>{r.description}</div></div>)}</div></div></article>})}</div></section>)}
<section class="section"><p class="source-note">Source：<code>{data.source.repository}@{data.source.commit.slice(0,8)}</code> · <code>{data.source.publicDocsManifest}</code></p></section>
</SiteLayout>