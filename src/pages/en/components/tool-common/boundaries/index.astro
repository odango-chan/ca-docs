---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import data from '../../../../../../data/generated/tool-common.json';
import { marked } from 'marked';
const base=import.meta.env.BASE_URL; const href=(v:string)=>`${base.replace(/\/?$/, '/')}${v.replace(/^\/+/, '')}`;
const html=marked.parse(data.pages.en.boundaries);
---
<SiteLayout title="tool-common boundaries" lang="en">
<section class="hero"><span class="eyebrow">tool-common</span><h1>Boundaries</h1><div class="page-tabs"><a href={href('/en/components/tool-common/api/')}>HTTP API</a><a href={href('/en/components/tool-common/subject-identity/')}>Subject Identity</a><a class="primary-tab" href={href('/en/components/tool-common/boundaries/')}>Boundaries</a><a href={href('/en/components/tool-common/')}>Overview</a></div></section>
<section class="section prose" set:html={html}></section>
</SiteLayout>