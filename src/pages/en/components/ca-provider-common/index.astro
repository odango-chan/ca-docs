---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import data from '../../../../../data/generated/ca-provider-common.json';
import { marked } from 'marked';
const base=import.meta.env.BASE_URL; const href=(v:string)=>`${base.replace(/\/?$/, '/')}${v.replace(/^\/+/, '')}`;
const html=marked.parse(data.pages.en.overview);
---
<SiteLayout title="ca-provider-common" lang="en">
<section class="hero"><span class="eyebrow">Component / ca-provider-common</span><h1>ca-provider-common</h1>
<div class="page-tabs"><a class="primary-tab" href={href('/en/components/ca-provider-common/api/')}>HTTP API</a><a href={href('/en/components/ca-provider-common/subject-identity/')}>Subject Identity</a><a href={href('/en/components/ca-provider-common/boundaries/')}>Boundaries</a><a href={href('/en/components/ca-provider-common/')}>Overview</a></div></section>
<section class="section prose" set:html={html}></section>
<section class="section"><div class="notice"><strong>The two surfaces are separate.</strong> The Provider listener is read-only for Runtime/Host. The Control listener is trusted provisioning/reset and is not an Agent tool.</div></section>
</SiteLayout>