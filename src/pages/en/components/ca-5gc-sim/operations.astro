---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import data from '../../../../../data/generated/ca-5gc-sim.json';
import { operationMetaEn, fallbackMeta } from '../../../../lib/ca5gc';

const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base}${value.replace(/^\//, '')}`;

const items = data.operations.map((semantic) => ({
  semantic,
  meta: operationMetaEn[semantic] ?? fallbackMeta(semantic, 'operation'),
}));
const groups = [...new Set(items.map((item) => item.meta.category))];
---
<SiteLayout title="ca-5gc-sim operations" lang="en">
  <section class="hero">
    <span class="eyebrow">ca-5gc-sim / Operations</span>
    <h1>{data.counts.operations} Operations</h1>
    <p class="lede">
      All operations use <code>POST /v1/operations</code>. The list below comes directly from the Operation schema.
    </p>
    <div class="page-tabs">
      <a href={href('/en/components/ca-5gc-sim/')}>Overview</a>
      <a href={href('/en/components/ca-5gc-sim/facts/')}>Facts</a>
      <a href={href('/en/components/ca-5gc-sim/api/')}>HTTP API</a>
    </div>
  </section>

  {groups.map((group) => (
    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">Group</span><h2>{group}</h2></div>
      </div>
      <div class="cap-list">
        {items.filter((item) => item.meta.category === group).map(({ semantic, meta }) => (
          <article class="cap-item">
            <div>
              <div class="semantic">{semantic}</div>
            </div>
            <div>
              <h3>{meta.title}</h3>
              <p class="meta">{meta.description}</p>
            </div>
            <div>
              <div class="meta">Subject</div>
              <code>{meta.subject}</code>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <p class="source-note">
    Source: <code>{data.source.operationSchema}</code>
  </p>
</SiteLayout>
