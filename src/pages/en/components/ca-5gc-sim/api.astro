---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import data from '../../../../../data/generated/ca-5gc-sim.json';

const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base}${value.replace(/^\//, '')}`;
const driftCount =
  data.drift.implementationOnlyRoutes.length + data.drift.documentedOnlyRoutes.length;
const sourceRef = data.source.commit || data.source.ref;
const sourceBase = `https://github.com/${data.source.repository}/blob/${sourceRef}`;
const openApiUrl = `${sourceBase}/${data.source.openApi}`;
const serverUrl = `${sourceBase}/${data.source.httpServer}`;
---
<SiteLayout title="ca-5gc-sim HTTP API" lang="en">
  <section class="hero">
    <span class="eyebrow">ca-5gc-sim / HTTP API</span>
    <h1>HTTP routes</h1>
    <p class="lede">
      This page compares OpenAPI with the routes registered in the Go server. Routes that exist only in code are listed too.
    </p>
    <div class="page-tabs">
      <a href={href('/en/components/ca-5gc-sim/')}>Overview</a>
      <a href={href('/en/components/ca-5gc-sim/facts/')}>Facts</a>
      <a href={href('/en/components/ca-5gc-sim/operations/')}>Operations</a>
      <a href={href('/en/components/ca-5gc-sim/standalone/')}>Standalone</a>
    </div>
  </section>

  <section class="section">
    <div class="stats">
      <div class="stat"><strong>{data.counts.documentedRoutes}</strong><span>OpenAPI routes</span></div>
      <div class="stat"><strong>{data.counts.implementationRoutes}</strong><span>Implementation routes</span></div>
      <div class="stat"><strong>{data.counts.facts}</strong><span>Facts behind /v1/facts/read</span></div>
      <div class="stat"><strong>{data.counts.operations}</strong><span>Operations behind /v1/operations</span></div>
    </div>
  </section>

  <section class="section">
    {driftCount > 0 ? (
      <div class="notice">
        There {driftCount === 1 ? 'is' : 'are'} {driftCount} route difference{driftCount === 1 ? '' : 's'} between OpenAPI and the server.
      </div>
    ) : (
      <div class="notice good">OpenAPI and the server routes match.</div>
    )}
    <div style="overflow-x:auto; margin-top:1rem">
      <table>
        <thead><tr><th>Method</th><th>Path</th><th>Surface</th><th>OpenAPI</th><th>Server</th></tr></thead>
        <tbody>
          {data.routes.map((route) => (
            <tr>
              <td><code>{route.method}</code></td>
              <td><code>{route.path}</code></td>
              <td>{route.surface}</td>
              <td>{route.documented ? '✓' : '—'}</td>
              <td>{route.implemented ? '✓' : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="notice private-source">
      <strong>The source repository is private.</strong>
      The route information needed here is already shown above. The two source links below require access to <code>{data.source.repository}</code> and point to commit <code>{sourceRef.slice(0, 8)}</code>.
    </div>
    <div class="grid" style="margin-top:1rem">
      <div class="card">
        <h3>OpenAPI</h3>
        <p><code>{data.source.openApi}</code></p>
        <div class="pills"><a class="pill" href={openApiUrl}>Open OpenAPI ↗</a></div>
      </div>
      <div class="card">
        <h3>HTTP registration code</h3>
        <p><code>{data.source.httpServer}</code></p>
        <div class="pills"><a class="pill" href={serverUrl}>Open server.go ↗</a></div>
      </div>
    </div>
  </section>
</SiteLayout>
