---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import data from '../../../../../data/generated/ca-5gc-sim.json';

const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
const driftCount =
  data.drift.implementationOnlyRoutes.length + data.drift.documentedOnlyRoutes.length;
const sourceVersion = data.source.commit ? data.source.commit.slice(0, 8) : data.source.ref;

const matrix = [
  ['Registration', 'UE_REGISTRATION · UE_REGISTRATION_CONTEXT', 'UE_REGISTRATION_ENSURE'],
  ['PDU session', 'PDU_SESSION', 'CREATE · MODIFY_QOS · RELEASE'],
  ['User plane', 'USER_PLANE_CONNECTIVITY', '—'],
  ['PFCP', 'PFCP_RESOURCE', 'PFCP_RESOURCE_CLEANUP'],
  ['Transfer participants', 'TRANSFER_PARTICIPANTS', '—'],
  ['Edge cache', '—', 'ENSURE · RECONCILE'],
  ['Virtual group', 'VIRTUAL_GROUP', 'CREATE · ASSIGN · RELEASE · RECONCILE'],
  ['Transfer QoS', 'TRANSFER_QOS', 'BOOST · RECONCILE'],
];
---
<SiteLayout title="ca-5gc-sim" lang="en">
  <section class="hero">
    <span class="eyebrow">Component / ca-5gc-sim</span>
    <h1>ca-5gc-sim</h1>
    <p class="lede">
      Simulates 5GC state and NF behavior. The Facts, Operations, and routes below are generated from the current schemas and code.
    </p>
    <div class="page-tabs"><a class="primary-tab" href={href('/en/components/ca-5gc-sim/api/')}>HTTP API</a><a href={href('/en/components/ca-5gc-sim/facts/')}>Facts</a><a href={href('/en/components/ca-5gc-sim/operations/')}>Operations</a><a href={href('/en/components/ca-5gc-sim/standalone/')}>Standalone</a><a href={href('/en/components/ca-5gc-sim/')}>Overview</a></div>
  </section>

  <section class="section">
    <div class="stats">
      <div class="stat"><strong>{data.counts.facts}</strong><span>Fact semantics</span></div>
      <div class="stat"><strong>{data.counts.operations}</strong><span>Operation semantics</span></div>
      <div class="stat"><strong>{data.counts.implementationRoutes}</strong><span>Server routes</span></div>
      <div class="stat"><strong>2</strong><span>Process profiles</span></div>
    </div>
    <div class="source-status snapshot">
      <div>
        <strong>Published snapshot</strong>
        <span>The site uses the latest successfully synced ca-5gc-sim data. The source repository is private; the Pages build does not read it directly.</span>
      </div>
      <code>{data.source.repository}@{sourceVersion}</code>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Capabilities</span>
        <h2>What it supports</h2>
      </div>
      <p>
        There are only a few HTTP entry points, but each semantic represents a different read or operation.
      </p>
    </div>
    <div style="overflow-x:auto">
      <table>
        <thead>
          <tr><th>Area</th><th>Readable fact</th><th>Mutation / reconcile</th></tr>
        </thead>
        <tbody>
          {matrix.map(([area, read, mutate]) => (
            <tr>
              <td><strong>{area}</strong></td>
              <td><code>{read}</code></td>
              <td><code>{mutate}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Handled elsewhere</span>
        <h2>These belong to other components</h2>
      </div>
    </div>
    <div class="grid">
      <div class="card"><h3>Network faults</h3><p>Drop, delay, reorder, and Network Observation live in <code>ca-service-fabric</code>.</p></div>
      <div class="card"><h3>Alias → execution identity</h3><p>Alias-to-execution-identity lookup lives in <code>ca-provider-common</code>.</p></div>
      <div class="card"><h3>Runtime Outcome</h3><p>SUCCEEDED / FAILED / OUTCOME_UNKNOWN and reconcile handling live in <code>ca-runtime</code>.</p></div>
      <div class="card"><h3>Agent-facing tools</h3><p>The simulator is not exposed directly as an Agent tool. Runtime / <code>ca-mcp</code> provides that interface.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">OpenAPI check</span>
        <h2>Does OpenAPI match the code?</h2>
      </div>
    </div>
    {driftCount === 0 ? (
      <div class="notice good">OpenAPI and the server routes match.</div>
    ) : (
      <div class="notice">
        There {driftCount === 1 ? 'is' : 'are'} {driftCount} route difference{driftCount === 1 ? '' : 's'} between OpenAPI and <code>internal/httpapi/server.go</code>.
        <a href={href('/en/components/ca-5gc-sim/api/')}> Inspect the route table →</a>
      </div>
    )}
  </section>
</SiteLayout>
