---
import SiteLayout from '../../layouts/SiteLayout.astro';
import data from '../../../data/generated/ca-5gc-sim.json';

const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
---
<SiteLayout title="ConnectionAgent docs" lang="en">
  <section class="home-hero">
    <h1>CA Docs</h1>
    <p>APIs, Facts, Operations, and component boundaries.</p>
  </section>

  <section class="home-section">
    <h2>Quick links</h2>
    <div class="doc-index">
      <a class="doc-row primary" href={href('/en/components/ca-5gc-sim/api/')}>
        <div><strong>HTTP API</strong><span>Endpoints, request fields, responses, schemas, and examples</span></div>
        <span aria-hidden="true">→</span>
      </a>
      <a class="doc-row" href={href('/en/components/ca-5gc-sim/facts/')}>
        <div><strong>Facts</strong><span>{data.counts.facts} readable states</span></div>
        <span aria-hidden="true">→</span>
      </a>
      <a class="doc-row" href={href('/en/components/ca-5gc-sim/operations/')}>
        <div><strong>Operations</strong><span>{data.counts.operations} executable operations</span></div>
        <span aria-hidden="true">→</span>
      </a>
      <a class="doc-row" href={href('/en/components/ca-5gc-sim/standalone/')}>
        <div><strong>Standalone</strong><span>Run and call ca-5gc-sim by itself</span></div>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="home-section">
    <h2>Components</h2>
    <div class="component-index">
      <a class="component-row" href={href('/en/components/ca-5gc-sim/')}>
        <div>
          <strong>ca-5gc-sim</strong>
          <span>5GC simulator · {data.counts.documentedRoutes} OpenAPI endpoints · {data.counts.implementationRoutes} server routes</span>
        </div>
        <span aria-hidden="true">→</span>
      </a>
      <div class="component-row muted-row">
        <div><strong>Other ca-* components</strong><span>More components will be added incrementally.</span></div>
      </div>
    </div>
  </section>

  <section class="home-section home-secondary">
    <a href={href('/en/architecture/')}>How docs are synchronized and who owns what →</a>
  </section>
</SiteLayout>
