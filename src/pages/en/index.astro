---
import SiteLayout from '../../layouts/SiteLayout.astro';
import data from '../../../data/generated/ca-5gc-sim.json';

const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
---
<SiteLayout title="ConnectionAgent docs" lang="en">
  <section class="home-hero">
    <h1>CA Docs</h1>
    <p>Explore the ConnectionAgent system architecture, Benchmark evaluation model, and public component APIs and contracts.</p>
  </section>

  <section class="home-section">
    <h2>Architecture and evaluation</h2>
    <div class="doc-index">
      <a class="doc-row primary" href={href('/en/architecture/system/')}><div><strong>CA system architecture</strong><span>Agent, Runtime, Provider, environment, and repository boundaries</span></div><span aria-hidden="true">→</span></a>
      <a class="doc-row primary" href={href('/en/benchmark/')}><div><strong>Benchmark architecture</strong><span>Assets, frozen tasks, attempts, evidence, and adjudication</span></div><span aria-hidden="true">→</span></a>
      <a class="doc-row" href={href('/en/architecture/')}><div><strong>Documentation governance</strong><span>Public sources, snapshot synchronization, and component docs ownership</span></div><span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-section">
    <h2>Component documentation</h2>
    <div class="doc-index">
      <a class="doc-row" href={href('/en/api/')}><div><strong>API</strong><span>Browse public APIs for integrated components</span></div><span aria-hidden="true">→</span></a>
      <a class="doc-row" href={href('/en/components/ca-5gc-sim/facts/')}><div><strong>Facts</strong><span>{data.counts.facts} readable states</span></div><span aria-hidden="true">→</span></a>
      <a class="doc-row" href={href('/en/components/ca-5gc-sim/operations/')}><div><strong>Operations</strong><span>{data.counts.operations} executable operations</span></div><span aria-hidden="true">→</span></a>
      <a class="doc-row" href={href('/en/components/ca-5gc-sim/standalone/')}><div><strong>ca-5gc-sim Standalone</strong><span>Run it independently</span></div><span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-section">
    <h2>Integrated components</h2>
    <div class="component-index">
      <a class="component-row" href={href('/en/components/ca-5gc-sim/')}><div><strong>ca-5gc-sim</strong><span>5GC simulator · {data.counts.documentedRoutes} OpenAPI endpoints · {data.counts.implementationRoutes} implementation routes</span></div><span aria-hidden="true">→</span></a>
      <a class="component-row" href={href('/en/components/tool-common/')}><div><strong>tool-common</strong><span>Subject Identity · Provider API + Trusted Control API</span></div><span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
