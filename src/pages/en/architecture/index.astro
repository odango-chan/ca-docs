---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base}${value.replace(/^\//, '')}`;
const flow = 'owner repository\n' +
  '  ├─ OpenAPI\n' +
  '  ├─ JSON Schema\n' +
  '  └─ implementation\n' +
  '         │\n' +
  '         ▼\n' +
  'ca-docs sync / validation\n' +
  '         │\n' +
  '         ├─ semantic inventory\n' +
  '         ├─ route inventory\n' +
  '         └─ drift detection\n' +
  '         │\n' +
  '         ▼\n' +
  'GitHub Pages docs';
---
<SiteLayout title="Documentation architecture" lang="en">
  <section class="hero">
    <span class="eyebrow">CA Docs / Architecture</span>
    <h1>Data stays in the component repositories</h1>
    <p class="lede">
      OpenAPI, schemas, and implementation stay in each <code>ca-*</code> repository. CA Docs reads them and builds a common set of pages.
    </p>
  </section>

  <section class="section">
    <div class="grid">
      <div class="card wide">
        <h3>How data gets here</h3>
        <pre><code>{flow}</code></pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="grid">
      <div class="card">
        <h3>Original definitions</h3>
        <p>Kept and versioned with the component that owns it.</p>
      </div>
      <div class="card">
        <h3>What CA Docs adds</h3>
        <p>Navigation, notes, examples, and links between repositories.</p>
      </div>
      <div class="card">
        <h3>When OpenAPI and code differ</h3>
        <p>The difference is shown directly.</p>
      </div>
      <div class="card">
        <h3>Adding another repository</h3>
        <p>Pick the schema/API/code files to read, then add that repository.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <a href={href('/en/components/ca-5gc-sim/')}>View the first integrated component →</a>
  </section>
</SiteLayout>
