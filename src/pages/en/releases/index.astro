---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { loadPublicCatalog } from '../../../lib/public-catalog';

const base = import.meta.env.BASE_URL;
const href = (value: string) => base.replace(/\/?$/, '/') + value.replace(/^\/+/, '');
const releases = loadPublicCatalog().flatMap(({ component, snapshot }) =>
  (snapshot.releases || []).map((release: any) => ({
    componentId: component.id,
    componentTitle: component.title?.en || component.id,
    repository: component.repository,
    release,
  })),
);
---
<SiteLayout title="Owner Releases" lang="en">
  <section class="home-hero">
    <h1>Owner Releases</h1>
    <p>Browse Owner Release Records. One Owner Release can contain multiple independent Contract ID / Version pairs.</p>
  </section>
  <section class="home-section">
    <div class="page-tabs">
      <a href={href('/en/contracts/')}>Contract Catalog</a>
      <a class="primary-tab" href={href('/en/releases/')}>Owner Releases</a>
    </div>
    {releases.length > 0 ? (
      <div class="doc-index">
        {releases.map((entry) => (
          <a class="doc-row" href={base + entry.release.releaseRecord.publicPath.replace(/^\/+/, '')}>
            <div>
              <strong>{entry.release.releaseId}</strong>
              <span>{entry.componentTitle} · {entry.repository} · {entry.release.contracts.length} contract versions</span>
            </div>
            <span>Release record →</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="notice">
        <strong>No Owner Release Records have been published through CA Docs yet.</strong>
        <p>Living Documentation does not automatically become a formal Release. Only explicitly declared Owner Releases appear here.</p>
      </div>
    )}
  </section>
</SiteLayout>
