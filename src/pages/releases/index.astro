---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadPublicCatalog } from '../../lib/public-catalog';

const base = import.meta.env.BASE_URL;
const href = (value: string) => base.replace(/\/?$/, '/') + value.replace(/^\/+/, '');
const releases = loadPublicCatalog().flatMap(({ component, snapshot }) =>
  (snapshot.releases || []).map((release: any) => ({
    componentId: component.id,
    componentTitle: component.title?.zh || component.id,
    repository: component.repository,
    release,
  })),
);
---
<SiteLayout title="Owner Releases" lang="zh">
  <section class="home-hero">
    <h1>Owner Releases</h1>
    <p>按 Owner Release Record 浏览一次发布中包含的契约版本。一个 Owner Release 可以包含多个独立 Contract ID / Version。</p>
  </section>
  <section class="home-section">
    <div class="page-tabs">
      <a href={href('/contracts/')}>Contract Catalog</a>
      <a class="primary-tab" href={href('/releases/')}>Owner Releases</a>
    </div>
    {releases.length > 0 ? (
      <div class="doc-index">
        {releases.map((entry) => (
          <a class="doc-row" href={base + entry.release.releaseRecord.publicPath.replace(/^\/+/, '')}>
            <div>
              <strong>{entry.release.releaseId}</strong>
              <span>{entry.componentTitle} · {entry.repository} · {entry.release.contracts.length} 个契约版本</span>
            </div>
            <span>发布记录 →</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="notice">
        <strong>尚无 Owner Release Record 发布到 CA Docs。</strong>
        <p>Living Documentation 不会自动变成正式 Release；只有显式发布的 Release 才会出现在此处。</p>
      </div>
    )}
  </section>
</SiteLayout>
