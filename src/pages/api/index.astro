---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getOpenApiSources, loadPublicCatalog } from '../../lib/public-catalog';

const base = import.meta.env.BASE_URL;
const href = (value: string) => base.replace(/\/?$/, '/') + value.replace(/^\/+/, '');
const scalarApis = loadPublicCatalog().flatMap(({ component, snapshot }) =>
  getOpenApiSources(snapshot)
    .filter((source: any) => source.rawPublicPath)
    .map((source: any) => ({
      componentId: component.id,
      componentTitle: component.title?.zh || component.id,
      repository: component.repository,
      source,
    })),
);
---
<SiteLayout title="API" lang="zh">
  <section class="home-hero">
    <h1>API Reference</h1>
    <p>按 Owner 和 API 契约浏览接口定义。原始 OpenAPI 只有在 Owner 显式授权后才会进入交互式参考。</p>
  </section>
  <section class="home-section">
    <h2>交互式 OpenAPI</h2>
    {scalarApis.length > 0 ? (
      <div class="doc-index">
        {scalarApis.map((api) => (
          <a class="doc-row primary" href={href('/api/' + api.componentId + '/' + api.source.role + '/')}>
            <div>
              <strong>{api.componentTitle} · {api.source.metadata?.title || api.source.role}</strong>
              <span>{api.source.role} · {api.repository} · {api.source.contractVersion || 'Living docs'}</span>
            </div>
            <span>→</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="notice">
        <strong>尚无已发布的原始 OpenAPI 快照。</strong>
        <p>Owner 需要在 PublicDocsManifest 中显式授权 raw，并完成一次严格同步后，这里才会出现 Scalar 页面。</p>
      </div>
    )}
  </section>
  <section class="home-section">
    <h2>接口摘要</h2>
    <div class="doc-index">
      <a class="doc-row" href={href('/components/ca-5gc-sim/api/')}>
        <div><strong>ca-5gc-sim</strong><span>5GC 模拟器 Owner API 摘要</span></div><span>→</span>
      </a>
      <a class="doc-row" href={href('/components/tool-common/api/')}>
        <div><strong>tool-common</strong><span>Provider API 与 Trusted Control API 摘要</span></div><span>→</span>
      </a>
    </div>
  </section>
  <section class="home-section">
    <div class="page-tabs">
      <a href={href('/contracts/')}>Contract Catalog</a>
      <a href={href('/schemas/')}>Schema Explorer</a>
    </div>
  </section>
</SiteLayout>
