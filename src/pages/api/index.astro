---
import SiteLayout from '../../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
const snapshots = Object.values(import.meta.glob('../../../data/generated/*.json', { eager: true, import: 'default' })) as any[];
const references = snapshots.flatMap((snapshot: any) =>
  (snapshot.sources || []).flatMap((source: any, index: number) =>
    source.kind === 'openapi' && source.rawArtifact?.url
      ? [{ component: snapshot.component, source, index, snapshot }]
      : [],
  ),
);
---
<SiteLayout title="API Reference" lang="zh">
  <section class="home-hero">
    <h1>API Reference</h1>
    <p>基于 Owner 原始 OpenAPI 契约生成的交互式接口文档。原始定义保留来源 Commit 与 SHA-256。</p>
  </section>
  <section class="home-section">
    <h2>OpenAPI References</h2>
    {references.length > 0 ? (
      <div class="doc-index">
        {references.map(({ component, source, index, snapshot }) => (
          <a class="doc-row primary" href={href(`/api-reference/${component}/${index}/`)}>
            <div>
              <strong>{source.metadata?.title || source.role || component}</strong>
              <span>{component} · {source.path} · {snapshot.source?.commit?.slice(0, 8) || 'unknown'}</span>
            </div>
            <span>→</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-state">尚无已授权发布的原始 OpenAPI 文件。Owner Manifest 迁移并完成同步后，接口参考会自动出现在这里。</p>
    )}
  </section>
  <section class="home-section">
    <h2>Curated API Guides</h2>
    <div class="doc-index">
      <a class="doc-row" href={href('/components/ca-5gc-sim/api/')}>
        <div><strong>env-5gc-sim</strong><span>5GC 模拟器接口与实现差异</span></div><span>→</span>
      </a>
      <a class="doc-row" href={href('/components/tool-common/api/')}>
        <div><strong>tool-common</strong><span>Provider HTTP API + Trusted Control API</span></div><span>→</span>
      </a>
    </div>
  </section>
</SiteLayout>
