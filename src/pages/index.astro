---
import SiteLayout from '../layouts/SiteLayout.astro';
import data from '../../data/generated/ca-5gc-sim.json';

const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
---
<SiteLayout title="ConnectionAgent 文档" lang="zh">
  <section class="home-hero">
    <h1>CA Docs</h1>
    <p>查 API、Facts、Operations 和组件边界。</p>
  </section>

  <section class="home-section">
    <h2>常用入口</h2>
    <div class="doc-index">
      <a class="doc-row primary" href={href('/components/ca-5gc-sim/api/')}>
        <div>
          <strong>HTTP API</strong>
          <span>接口、请求字段、响应、Schema 和示例</span>
        </div>
        <span aria-hidden="true">→</span>
      </a>
      <a class="doc-row" href={href('/components/ca-5gc-sim/facts/')}>
        <div>
          <strong>Facts</strong>
          <span>{data.counts.facts} 个可读取的状态</span>
        </div>
        <span aria-hidden="true">→</span>
      </a>
      <a class="doc-row" href={href('/components/ca-5gc-sim/operations/')}>
        <div>
          <strong>Operations</strong>
          <span>{data.counts.operations} 个可执行操作</span>
        </div>
        <span aria-hidden="true">→</span>
      </a>
      <a class="doc-row" href={href('/components/ca-5gc-sim/standalone/')}>
        <div>
          <strong>Standalone</strong>
          <span>怎么单独启动和调用 ca-5gc-sim</span>
        </div>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="home-section">
    <h2>组件</h2>
    <div class="component-index">
      <a class="component-row" href={href('/components/ca-5gc-sim/')}>
        <div>
          <strong>ca-5gc-sim</strong>
          <span>5GC 模拟器 · {data.counts.documentedRoutes} 个 OpenAPI 接口 · {data.counts.implementationRoutes} 条实现路由</span>
        </div>
        <span aria-hidden="true">→</span>
      </a>
      <div class="component-row muted-row">
        <div>
          <strong>其他 ca-* 组件</strong>
          <span>后续按组件逐步接入。</span>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-secondary">
    <a href={href('/architecture/')}>文档怎么同步、各仓库怎么分工 →</a>
  </section>
</SiteLayout>
