---
import SiteLayout from '../layouts/SiteLayout.astro';
import data from '../../data/generated/ca-5gc-sim.json';
const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
---
<SiteLayout title="Sandbox 文档" lang="zh" description="Sandbox 平台的总体架构、组件职责、可靠性 Benchmark 与公开接口文档。">
  <section class="home-hero">
    <div class="home-kicker">SANDBOX · PLATFORM DOCUMENTATION</div>
    <h1>Sandbox 平台文档</h1>
    <p>Sandbox 将 Agent、工具、环境、实验控制和评估组件组合为可重复运行的系统。这里介绍平台的架构与职责边界，并提供各组件维护的公开接口和契约。</p>
    <div class="home-actions">
      <a href={href('/architecture/system/#real-5gc-workflow')}>真实 5GC 工作流 <span aria-hidden="true">→</span></a>
      <a href={href('/benchmark/')}>Benchmark 设计 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-section">
    <h2>平台概览</h2>
    <p>Sandbox 是产品级组合与治理层，不是一个模拟器，也不接管各组件的领域事实。它支持在模拟、真实或混合环境中组合不同实现。</p>
    <div class="reading-list">
      <a class="reading-item" href={href('/architecture/system/')}>
        <span class="reading-number">01</span>
        <span><strong>总体架构与组件边界</strong><small>从真实 Open5GS / UERANSIM 的 SBI 请求看清 Fabric、SCP、Agent 与 Runtime 如何协作，以及 R1 和 R2-B 的状态差异。</small></span>
        <span class="reading-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="reading-item" href={href('/benchmark/')}>
        <span class="reading-number">02</span>
        <span><strong>Benchmark 与可靠性评估</strong><small>了解评估资产、被测对象、冻结任务、执行尝试、证据判定与结果聚合的边界。</small></span>
        <span class="reading-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="reading-item" href={href('/architecture/')}>
        <span class="reading-number">03</span>
        <span><strong>文档来源与治理</strong><small>了解组件如何声明公开文档来源，以及本站如何校验、同步和发布快照。</small></span>
        <span class="reading-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="home-section">
    <h2>组件参考</h2>
    <p>平台级文档说明组件如何组合；接口、状态和操作的具体定义仍由各组件所属仓库维护。</p>
    <table class="component-table">
      <thead><tr><th>组件</th><th>所属层</th><th>公开参考</th></tr></thead>
      <tbody>
        <tr>
          <td><a href={href('/components/ca-5gc-sim/')}>env-5gc-sim</a></td>
          <td>Environment Plane</td>
          <td><a href={href('/api/')}>API</a> · <a href={href('/components/ca-5gc-sim/facts/')}>Facts（{data.counts.facts}）</a> · <a href={href('/components/ca-5gc-sim/operations/')}>Operations（{data.counts.operations}）</a></td>
        </tr>
        <tr>
          <td><a href={href('/components/tool-common/')}>tool-common</a></td>
          <td>Tool Plane</td>
          <td><a href={href('/components/tool-common/')}>组件概览</a> · <a href={href('/components/tool-common/subject-identity/')}>Subject Identity</a></td>
        </tr>
      </tbody>
    </table>
    <p class="home-footnote">上表只列出当前已接入的公开参考，不代表 Sandbox 的完整组件清单。组件迁移和仓名变更按各 owner 仓库的状态推进。</p>
  </section>

  <section class="home-section">
    <h2>文档与实现的关系</h2>
    <p>本站负责平台级说明、跨仓导航和经过校验的公开快照。各组件所属仓库仍是其实现、机器契约和权威事实的来源。Sandbox 的目标架构已建立，跨仓迁移和消费者验收仍在分阶段进行；设计已接受不等于所有能力均已实现。</p>
    <p><a href={href('/architecture/')}>查看文档来源与同步规则 →</a></p>
  </section>
</SiteLayout>
