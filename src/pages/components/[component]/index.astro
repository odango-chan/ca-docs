---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { renderPublicMarkdown } from '../../../lib/public-markdown.mjs';

export function getStaticPaths() {
  const registry = yaml.load(fs.readFileSync(path.resolve('data/components.yaml'), 'utf8'));
  return (registry.components || [])
    .filter((component) => component.status === 'active' && component.sync === 'manifest')
    .map((component) => {
      const snapshotPath = path.resolve('data/generated', `${component.id}.json`);
      const data = JSON.parse(fs.readFileSync(snapshotPath, 'utf8'));
      return { params: { component: component.id }, props: { data } };
    });
}

const { data } = Astro.props;
const title = data.title?.zh || data.component;
const markdownSources = data.sources.filter((source) => source.kind === 'markdown' && source.body && (!source.language || source.language === 'zh'));
const publicDocs = markdownSources.map((source) => ({ source, ...renderPublicMarkdown(source.body, { ...data.source, path: source.path, role: source.role }) }));
const apiSources = data.sources.filter((source) => source.kind === 'openapi');
const contractSources = data.sources.filter((source) => source.kind === 'json-schema');
const fieldDescription = (field) => {
  if (Object.hasOwn(field, 'const')) return `固定值：${field.const}`;
  if (Array.isArray(field.enum)) return `可选：${field.enum.join(' / ')}`;
  return field.description || `类型：${field.type || '结构'}`;
};
const base = import.meta.env.BASE_URL;
const href = (value) => `${base.replace(/\/?$/, '/')}${value.replace(/^\/+/, '')}`;
---

<SiteLayout title={`${title} 文档与接口`} lang="zh">
  <section class="hero">
    <span class="eyebrow">组件 / {data.component}</span>
    <h1>{title}</h1>
    <div class="page-tabs"><a class="primary-tab" href={href(`/components/${data.component}/`)}>文档、API 与契约</a></div>
  </section>

  <section class="source-status owner-provenance" aria-label="来源与状态">
    <div><strong>源仓授权发布 · 固定版本</strong><span>{data.source.repository} · {data.source.commit || data.source.ref}{data.source.commitDate ? ` · ${data.source.commitDate.slice(0, 10)}` : ""}</span></div>
    <p>本站展示经 owner 明确授权的文档正文与契约摘要。实现状态以源仓文档和对应验收证据为准；同步或构建成功本身不代表功能已实现或验收通过。</p>
  </section>

  {publicDocs.map(({ source, title: documentTitle, html }) => <section class="section" id={source.role}>
    <div class="section-head"><div><span class="eyebrow">源仓文档 / Owner documentation</span><h2>{documentTitle}</h2></div></div>
    <div class="prose owner-document" set:html={html}></div>
    <p class="source-note">来源文件：<code>{source.path}</code> · 固定版本：<code>{data.source.commit?.slice(0, 12) || data.source.ref}</code></p>
  </section>)}

  {apiSources.length > 0 && <section class="section">
    <div class="section-head"><div><span class="eyebrow">OpenAPI</span><h2>HTTP API</h2></div></div>
    {apiSources.map((api) => <div class="section" id={api.role}>
      <h3>{api.metadata?.title || api.role}</h3>
      {api.metadata?.description && <p>{api.metadata.description}</p>}
      <div class="api-list">{api.operations.map((operation) => <article class="api-card">
        <div class="api-heading"><span class:list={['method-badge', operation.method.toLowerCase()]}>{operation.method}</span><code class="api-path">{operation.path}</code></div>
        <h3>{operation.summary || operation.operationId}</h3>
        {operation.operationId && <div class="api-meta"><span>operationId</span><code>{operation.operationId}</code></div>}
        {operation.request && <p>请求契约：<code>{operation.request.schema}</code></p>}
        <div class="response-list">{operation.responses.map((response) => <div class="response-row"><code class="status-code">{response.status}</code><div>{response.description}</div></div>)}</div>
      </article>)}</div>
    </div>)}
  </section>}

  {contractSources.length > 0 && <section class="section">
    <div class="section-head"><div><span class="eyebrow">JSON Schema</span><h2>数据契约</h2></div></div>
    {contractSources.map((contract) => <article class="api-card">
      <h3>{contract.metadata?.title || contract.role}</h3>
      {contract.metadata?.description && <p>{contract.metadata.description}</p>}
      <code class="source-note">{contract.metadata?.id}</code>
      {contract.fields.length > 0 && <table><thead><tr><th>字段</th><th>说明</th></tr></thead><tbody>
        {contract.fields.map((field) => <tr><td><code>{field.path}</code></td><td>{fieldDescription(field)}</td></tr>)}
      </tbody></table>}
    </article>)}
  </section>}

  <section class="section"><p class="source-note">来源：<code>{data.source.repository}@{data.source.commit?.slice(0, 8) || data.source.ref}</code> · <code>{data.source.publicDocsManifest}</code></p></section>
</SiteLayout>
