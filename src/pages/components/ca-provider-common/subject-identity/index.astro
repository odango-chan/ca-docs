---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import data from '../../../../../data/generated/ca-provider-common.json';
import { marked } from 'marked';
const base=import.meta.env.BASE_URL; const href=(v:string)=>`${base.replace(/\/?$/, '/')}${v.replace(/^\/+/, '')}`;
const html=marked.parse(data.pages.zh.subjectIdentity);
---
<SiteLayout title="Subject Identity" lang="zh">
<section class="hero"><span class="eyebrow">ca-provider-common</span><h1>Subject Identity</h1><div class="page-tabs"><a href={href('/components/ca-provider-common/api/')}>HTTP API</a><a class="primary-tab" href={href('/components/ca-provider-common/subject-identity/')}>Subject Identity</a><a href={href('/components/ca-provider-common/boundaries/')}>职责边界</a><a href={href('/components/ca-provider-common/')}>概览</a></div></section>
<section class="section prose" set:html={html}></section>
</SiteLayout>