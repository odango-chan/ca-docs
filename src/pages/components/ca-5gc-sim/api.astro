---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import data from '../../../../data/generated/ca-5gc-sim.json';

const base = import.meta.env.BASE_URL;
const href = (value: string) => `${base}${value.replace(/^\//, '')}`;
const driftCount =
  data.drift.implementationOnlyRoutes.length + data.drift.documentedOnlyRoutes.length;
const sourceRef = data.source.commit || data.source.ref;
const sourceBase = `https://github.com/${data.source.repository}/blob/${sourceRef}`;
const openApiUrl = `${sourceBase}/${data.source.openApi}`;
const serverUrl = `${sourceBase}/${data.source.httpServer}`;
const surfaceZh: Record<string, string> = {
  Diagnostics: '诊断',
  'Owner API': 'Owner API',
  'Host control': 'Host 控制',
  'Fabric integration': 'Fabric 内部集成',
};
---
<SiteLayout title="ca-5gc-sim HTTP API" lang="zh">
  <section class="hero">
    <span class="eyebrow">ca-5gc-sim / HTTP API</span>
    <h1>HTTP 路由</h1>
    <p class="lede">
      这里同时看 OpenAPI 和 Go 代码里实际注册的路由。只写在代码里、还没进 OpenAPI 的接口也会列出来。
    </p>
    <div class="page-tabs">
      <a href={href('/components/ca-5gc-sim/')}>概览</a>
      <a href={href('/components/ca-5gc-sim/facts/')}>Facts</a>
      <a href={href('/components/ca-5gc-sim/operations/')}>Operations</a>
      <a href={href('/components/ca-5gc-sim/standalone/')}>Standalone</a>
    </div>
  </section>

  <section class="section">
    <div class="stats">
      <div class="stat"><strong>{data.counts.documentedRoutes}</strong><span>OpenAPI 路由</span></div>
      <div class="stat"><strong>{data.counts.implementationRoutes}</strong><span>实现路由</span></div>
      <div class="stat"><strong>{data.counts.facts}</strong><span>/v1/facts/read 背后的 Facts</span></div>
      <div class="stat"><strong>{data.counts.operations}</strong><span>/v1/operations 背后的 Operations</span></div>
    </div>
  </section>

  <section class="section">
    {driftCount > 0 ? (
      <div class="notice">
        目前有 {driftCount} 条路由对不上：OpenAPI 和 Server 注册的结果不完全一致。
      </div>
    ) : (
      <div class="notice good">OpenAPI 和 Server 注册的路由一致。</div>
    )}

    <div style="overflow-x:auto; margin-top:1rem">
      <table>
        <thead><tr><th>方法</th><th>路径</th><th>能力面</th><th>OpenAPI</th><th>Server</th></tr></thead>
        <tbody>
          {data.routes.map((route) => (
            <tr>
              <td><code>{route.method}</code></td>
              <td><code>{route.path}</code></td>
              <td>{surfaceZh[route.surface] ?? route.surface}</td>
              <td>{route.documented ? '✓' : '—'}</td>
              <td>{route.implemented ? '✓' : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="notice private-source">
      <strong>源码仓库是 private。</strong>
      本页已经列出了公开需要看的路由信息。下面两个源码链接只有有
      <code>{data.source.repository}</code> 权限的人能打开，链接固定到提交
      <code>{sourceRef.slice(0, 8)}</code>。
    </div>
    <div class="grid" style="margin-top:1rem">
      <div class="card">
        <h3>OpenAPI</h3>
        <p><code>{data.source.openApi}</code></p>
        <div class="pills"><a class="pill" href={openApiUrl}>打开 OpenAPI ↗</a></div>
      </div>
      <div class="card">
        <h3>HTTP 注册代码</h3>
        <p><code>{data.source.httpServer}</code></p>
        <div class="pills"><a class="pill" href={serverUrl}>打开 server.go ↗</a></div>
      </div>
    </div>
  </section>
</SiteLayout>
