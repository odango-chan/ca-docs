---
import SiteLayout from '../../../layouts/SiteLayout.astro'; import data from '../../../../data/generated/ca-5gc-sim.json';
const base=import.meta.env.BASE_URL; const href=(value:string)=>`${base}${value.replace(/^\//,'')}`; const driftCount=data.drift.implementationOnlyRoutes.length+data.drift.documentedOnlyRoutes.length; const sourceVersion=data.source.commit?data.source.commit.slice(0,8):data.source.ref;
const matrix=[['注册','UE_REGISTRATION · UE_REGISTRATION_CONTEXT','UE_REGISTRATION_ENSURE'],['PDU 会话','PDU_SESSION','CREATE · MODIFY_QOS · RELEASE'],['用户面','USER_PLANE_CONNECTIVITY','—'],['PFCP','PFCP_RESOURCE','PFCP_RESOURCE_CLEANUP'],['传输参与方','TRANSFER_PARTICIPANTS','—'],['边缘缓存','—','ENSURE · RECONCILE'],['虚拟组','VIRTUAL_GROUP','CREATE · ASSIGN · RELEASE · RECONCILE'],['传输 QoS','TRANSFER_QOS','BOOST · RECONCILE']];
---
<SiteLayout title="ca-5gc-sim" lang="zh">
<section class="hero"><span class="eyebrow">组件 / ca-5gc-sim</span><h1>确定性 5GC 模拟器</h1><p class="lede">模拟 5GC 领域状态与确定性的 NF 行为。下面的能力清单直接来自当前上游 Schema 与 HTTP 路由实现，而不是人工重新抄一份。</p><div class="page-tabs"><a href={href('/components/ca-5gc-sim/')}>概览</a><a href={href('/components/ca-5gc-sim/facts/')}>Facts</a><a href={href('/components/ca-5gc-sim/operations/')}>Operations</a><a href={href('/components/ca-5gc-sim/api/')}>HTTP API</a><a href={href('/components/ca-5gc-sim/standalone/')}>Standalone</a></div></section>
<section class="section"><div class="stats"><div class="stat"><strong>{data.counts.facts}</strong><span>Fact semantic</span></div><div class="stat"><strong>{data.counts.operations}</strong><span>Operation semantic</span></div><div class="stat"><strong>{data.counts.implementationRoutes}</strong><span>Server 实际路由</span></div><div class="stat"><strong>2</strong><span>进程 Profile</span></div></div><div class="source-status snapshot">
      <div>
        <strong>已发布快照</strong>
        <span>Pages 使用最近一次成功同步并提交的安全派生快照；private token 不进入 Pages 构建。</span>
      </div>
      <code>{data.source.repository}@{sourceVersion}</code>
    </div></section>
<section class="section"><div class="section-head"><div><span class="eyebrow">能力矩阵</span><h2>当前模拟器真正拥有的能力</h2></div><p>Fact 读取与 Mutation 共用少量通用 HTTP 入口，但真正有意义的能力面是它们背后的 semantic。</p></div><div style="overflow-x:auto"><table><thead><tr><th>领域</th><th>可读取 Fact</th><th>Mutation / Reconcile</th></tr></thead><tbody>{matrix.map(([area,read,mutate])=><tr><td><strong>{area}</strong></td><td><code>{read}</code></td><td><code>{mutate}</code></td></tr>)}</tbody></table></div></section>
<section class="section"><div class="section-head"><div><span class="eyebrow">职责边界</span><h2>这些事情故意不由 ca-5gc-sim 负责</h2></div></div><div class="grid"><div class="card"><h3>网络故障</h3><p>Drop、Delay、Reorder 与 Network Observation 属于 <code>ca-service-fabric</code>。</p></div><div class="card"><h3>Alias → 执行身份</h3><p>用户可读别名到执行身份的解析属于 <code>ca-provider-common</code>。</p></div><div class="card"><h3>Runtime Outcome</h3><p>SUCCEEDED / FAILED / OUTCOME_UNKNOWN 与 Reconcile 策略属于 <code>ca-runtime</code>。</p></div><div class="card"><h3>Agent-facing Tool</h3><p>模拟器本身不是 MCP 能力面；Agent 暴露应经过 Runtime 准入并由 <code>ca-mcp</code> 提供。</p></div></div></section>
<section class="section"><div class="section-head"><div><span class="eyebrow">契约健康度</span><h2>OpenAPI 与实际实现</h2></div></div>{driftCount===0?<div class="notice good">当前 OpenAPI 路由清单与 HTTP Server 实现一致。</div>:<div class="notice">当前检测到 {driftCount} 处 OpenAPI 与 <code>internal/httpapi/server.go</code> 的路由差异。<a href={href('/components/ca-5gc-sim/api/')}> 查看具体路由 →</a></div>}</section>
</SiteLayout>