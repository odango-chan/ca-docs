---
import SiteLayout from '../../../layouts/SiteLayout.astro'; import data from '../../../../data/generated/ca-5gc-sim.json'; import { factMetaZh,fallbackMeta } from '../../../lib/ca5gc';
const base=import.meta.env.BASE_URL; const href=(value:string)=>`${base}${value.replace(/^\//,'')}`;
---
<SiteLayout title="ca-5gc-sim Facts" lang="zh"><section class="hero"><span class="eyebrow">ca-5gc-sim / Facts</span><h1>可读取的 {data.counts.facts} 个 Facts</h1><p class="lede">读取都走 <code>POST /v1/facts/read</code>。具体读什么，由 <code>factSemantic</code> 和 <code>subjectRef</code> 决定。</p><div class="page-tabs"><a href={href('/components/ca-5gc-sim/')}>概览</a><a href={href('/components/ca-5gc-sim/operations/')}>Operations</a><a href={href('/components/ca-5gc-sim/api/')}>HTTP API</a></div></section><section class="section"><div class="cap-list">{data.facts.map((semantic)=>{const meta=factMetaZh[semantic]??fallbackMeta(semantic,'fact','zh');return <article class="cap-item"><div><div class="semantic">{semantic}</div><div class="meta">{meta.category}</div></div><div><h3>{meta.title}</h3><p class="meta">{meta.description}</p></div><div><div class="meta">Subject</div><code>{meta.subject}</code></div></article>;})}</div><p class="source-note">来源：<code>{data.source.factSchema}</code></p></section></SiteLayout>