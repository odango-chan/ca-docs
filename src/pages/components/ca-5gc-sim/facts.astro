---
import SiteLayout from '../../../layouts/SiteLayout.astro'; import data from '../../../../data/generated/ca-5gc-sim.json'; import { factMetaZh,fallbackMeta } from '../../../lib/ca5gc';
const base=import.meta.env.BASE_URL; const href=(value:string)=>`${base}${value.replace(/^\//,'')}`;
---
<SiteLayout title="ca-5gc-sim Facts" lang="zh"><section class="hero"><span class="eyebrow">ca-5gc-sim / Facts</span><h1>{data.counts.facts} 个可读取的领域 Fact</h1><p class="lede">所有 Fact semantic 都通过 <code>POST /v1/facts/read</code> 读取。semantic 与带类型的 <code>subjectRef</code> 一起决定要读取哪一类权威 5GC 状态。</p><div class="page-tabs"><a href={href('/components/ca-5gc-sim/')}>概览</a><a href={href('/components/ca-5gc-sim/operations/')}>Operations</a><a href={href('/components/ca-5gc-sim/api/')}>HTTP API</a></div></section><section class="section"><div class="cap-list">{data.facts.map((semantic)=>{const meta=factMetaZh[semantic]??fallbackMeta(semantic,'fact','zh');return <article class="cap-item"><div><div class="semantic">{semantic}</div><div class="meta">{meta.category}</div></div><div><h3>{meta.title}</h3><p class="meta">{meta.description}</p></div><div><div class="meta">Subject</div><code>{meta.subject}</code></div></article>;})}</div><p class="source-note">清单由 <code>{data.source.factSchema}</code> 自动生成。</p></section></SiteLayout>