---
import SiteLayout from '../../../layouts/SiteLayout.astro'; import data from '../../../../data/generated/ca-5gc-sim.json'; import { operationMetaZh,fallbackMeta } from '../../../lib/ca5gc';
const base=import.meta.env.BASE_URL; const href=(value:string)=>`${base}${value.replace(/^\//,'')}`; const items=data.operations.map((semantic)=>({semantic,meta:operationMetaZh[semantic]??fallbackMeta(semantic,'operation','zh')})); const groups=[...new Set(items.map((item)=>item.meta.category))];
---
<SiteLayout title="ca-5gc-sim Operations" lang="zh"><section class="hero"><span class="eyebrow">ca-5gc-sim / Operations</span><h1>{data.counts.operations} 个 Operations</h1><p class="lede">操作都走 <code>POST /v1/operations</code>。下面的列表直接来自 Operation Schema。</p><div class="page-tabs"><a href={href('/components/ca-5gc-sim/')}>概览</a><a href={href('/components/ca-5gc-sim/facts/')}>Facts</a><a href={href('/components/ca-5gc-sim/api/')}>HTTP API</a></div></section>{groups.map((group)=><section class="section"><div class="section-head"><div><span class="eyebrow">分组</span><h2>{group}</h2></div></div><div class="cap-list">{items.filter((item)=>item.meta.category===group).map(({semantic,meta})=><article class="cap-item"><div><div class="semantic">{semantic}</div></div><div><h3>{meta.title}</h3><p class="meta">{meta.description}</p></div><div><div class="meta">Subject</div><code>{meta.subject}</code></div></article>)}</div></section>)}<p class="source-note">来源：<code>{data.source.operationSchema}</code></p></SiteLayout>