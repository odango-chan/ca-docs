---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadPublicCatalog } from '../../lib/public-catalog';

const base = import.meta.env.BASE_URL;
const href = (value: string) => base.replace(/\/?$/, '/') + value.replace(/^\/+/, '');
const contracts = loadPublicCatalog().flatMap(({ component, snapshot }) =>
  (snapshot.releases || []).filter((release: any) => release.publicationStatus !== 'WITHDRAWN').flatMap((release: any) =>
    (release.contracts || []).map((contract: any) => ({
      componentId: component.id,
      componentTitle: component.title?.zh || component.id,
      repository: component.repository,
      release,
      contract,
    })),
  ),
);
---
<SiteLayout title="Contract Catalog" lang="zh">
  <section class="home-hero">
    <h1>Contract Catalog</h1>
    <p>只展示 Owner 明确发布的不可变契约版本。契约版本、Owner 产品版本和 CA-SL 语言版本彼此独立。</p>
  </section>
  <section class="home-section">
    <div class="page-tabs">
      <a class="primary-tab" href={href('/contracts/')}>契约版本</a>
      <a href={href('/releases/')}>Owner Releases</a>
      <a href={href('/schemas/')}>Schema Explorer</a>
    </div>
    {contracts.length > 0 ? (
      <div class="doc-index">
        {contracts.map((entry) => (
          <a class="doc-row" href={href('/contracts/' + entry.componentId + '/' + entry.contract.contractId + '/' + entry.contract.version + '/')}>
            <div>
              <strong>{entry.contract.contractId} · {entry.contract.version}</strong>
              <span>{entry.componentTitle} · {entry.repository} · {entry.contract.lifecycleStatus} · {entry.release.publicationStatus}</span>
            </div>
            <span>→</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="notice">
        <strong>当前还没有正式契约版本通过 CA Docs 发布。</strong>
        <p>现有 Owner 文档和 OpenAPI 摘要仍可浏览。正式契约只有在 Owner 提供不可变 Release Record、Commit 和文件白名单后才会出现在这里。</p>
      </div>
    )}
  </section>
</SiteLayout>
