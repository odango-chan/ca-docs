---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadPublicCatalog } from '../../lib/public-catalog';

const base = import.meta.env.BASE_URL;
const href = (value: string) => base.replace(/\/?$/, '/') + value.replace(/^\/+/, '');
const schemas = loadPublicCatalog().flatMap(({ component, snapshot }) =>
  (snapshot.sources || [])
    .filter((source: any) => source.kind === 'json-schema')
    .map((source: any) => ({
      componentId: component.id,
      componentTitle: component.title?.zh || component.id,
      repository: component.repository,
      source,
      commit: snapshot.source?.commit,
    })),
);
---
<SiteLayout title="Schema Explorer" lang="zh">
  <section class="home-hero">
    <h1>Schema Explorer</h1>
    <p>按 Owner 浏览 JSON Schema 的字段、类型、必填约束、枚举、条件规则和跨文件引用。原始 Schema 仅在 Owner 明确授权 raw 后提供下载。</p>
  </section>
  <section class="home-section">
    {schemas.length > 0 ? (
      <div class="doc-index">
        {schemas.map((entry) => (
          <a class="doc-row" href={href('/schemas/' + entry.componentId + '/' + entry.source.role + '/')}>
            <div>
              <strong>{entry.componentTitle} · {entry.source.metadata?.title || entry.source.role}</strong>
              <span>{entry.source.role} · {entry.source.path}</span>
            </div>
            <span>→</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="notice">
        <strong>Schema Catalog 尚未刷新到 CA Docs v2 快照。</strong>
        <p>完成 Owner Manifest v1alpha2 迁移和严格同步后，Schema 页面会自动从发布快照生成。</p>
      </div>
    )}
  </section>
</SiteLayout>
